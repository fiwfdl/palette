---
import BaseLayout from "../layouts/BaseLayout.astro";
import PaletteGenerator from "../components/PaletteGenerator.tsx";

const notes = [
  {
    title: "Deterministic",
    body: "Every ramp comes from a seeded generator, so the same hue and seed reproduce the exact same swatches.",
  },
  {
    title: "Accessible",
    body: "Each swatch reports the contrast of its readable text tone and grades it against the WCAG AA/AAA thresholds.",
  },
  {
    title: "Token-driven",
    body: "The interface is built from the template's OKLCH semantic tokens, in both light and dark themes.",
  },
];
---

<BaseLayout
  title="Palette — an OKLCH colour palette generator"
  description="Generate an OKLCH palette, lock the swatches you like, and copy the ramp as hex, CSS variables, or JSON."
>
  <section class="field-ring relative border-b border-border">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
      <p
        class="text-sm font-medium uppercase tracking-[0.18em] text-muted-foreground"
      >
        OKLCH palette generator
      </p>
      <h1
        class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-foreground sm:text-5xl md:text-6xl"
      >
        Generate a palette you can actually ship.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted-foreground">
        Pick a base hue, lock the swatches you like, and regenerate the rest.
        Every swatch reports its WCAG text contrast, and the whole ramp copies
        out as hex, CSS variables, or JSON.
      </p>
    </div>
  </section>

  <section id="generator" class="scroll-mt-24 border-b border-border">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 md:py-16">
      <PaletteGenerator client:load />
    </div>
  </section>

  <section id="about" class="scroll-mt-24">
    <div
      class="mx-auto grid max-w-6xl gap-6 px-4 py-12 sm:px-6 md:grid-cols-3 md:py-16"
    >
      {
        notes.map((note) => (
          <div class="rounded-[var(--radius)] border border-border bg-surface p-6 text-surface-foreground">
            <h2 class="text-lg font-semibold">{note.title}</h2>
            <p class="mt-2 text-sm text-muted-foreground">{note.body}</p>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

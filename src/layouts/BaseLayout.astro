---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Starter — Build your next web product.",
  description = "A generic Astro starter with Tailwind, Radix islands, semantic tokens, and a self-hosted type system.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      (() => {
        const STORAGE_KEY = "entrypoint-theme";
        const root = document.documentElement;
        let stored = null;
        try {
          stored = window.localStorage.getItem(STORAGE_KEY);
        } catch {
          stored = null;
        }
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const isDark =
          stored === "dark" || stored === "light"
            ? stored === "dark"
            : prefersDark;
        root.classList.toggle("dark", isDark);
        root.style.colorScheme = isDark ? "dark" : "light";
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-background text-foreground antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-[var(--radius)] focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-primary-foreground"
      >Skip to content</a
    >
    <div class="flex min-h-dvh flex-col">
      <Header />
      <main id="main" tabindex="-1" class="flex-1 outline-none">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
